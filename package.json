{
  "name": "artlantix",
  "version": "0.6.0",
  "private": true,
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "node --test tests/regressions.mjs infra/malware-scanner/scanner.test.mjs",
    "db:start": "supabase start",
